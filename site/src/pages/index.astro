---
/**
 * usepagecue.com: the product page. Its one bold element is the stage, a small working copy of
 * pagecue: scroll the report and the prompter follows; click a cue and the report scrolls to it.
 * Everything else stays quiet. Colours and type are the prompter's own (src/styles/theme.css).
 */
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import Mark from '../assets/mark.svg?raw';

const repo = 'https://github.com/pakothealpaco/pagecue';
const title = 'pagecue: speaker notes for any web page, written with Claude';
const description =
  'Speaker notes for any report, dashboard or site, written with Claude, in a private window that follows the page as you scroll. Free for Chrome.';
// Structured data: the site's name in search results, the maker's logo, and the extension itself.
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'pagecue',
    alternateName: 'usepagecue.com',
    url: 'https://usepagecue.com/',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'pagecue',
    url: 'https://usepagecue.com/',
    logo: 'https://usepagecue.com/icon-512.png',
    sameAs: [repo, 'https://www.youtube.com/@pakothealpaco'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'pagecue',
    description,
    url: 'https://usepagecue.com/',
    image: 'https://usepagecue.com/og.png',
    applicationCategory: 'BrowserApplication',
    operatingSystem: 'Chrome',
    license: 'https://opensource.org/licenses/MIT',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    sameAs: [repo],
  },
];

// The demo report's cues (site/public/demo), shortened to five parts for the stage.
const parts = [
  {
    heading: 'Q3 partner review',
    body: 'Halcyon Roasters × Northside Market. Our best quarter yet, and what we propose for Q4.',
    kind: 'title',
    cue: 'Best quarter yet: $4.2M, up 31%',
    notes: ['Thank them for the shelf space', 'One ask at the end: the Q4 co-promo'],
  },
  {
    heading: 'The quarter in four numbers',
    kind: 'stats',
    cue: 'Four numbers, then stop talking',
    notes: ['Repeat rate 68% is the one to land', 'Margin held despite green coffee prices'],
  },
  {
    heading: 'Revenue by month',
    body: 'Thousands of dollars. The cold brew line launched on August 12.',
    kind: 'chart',
    cue: 'September doubled March',
    notes: ['Spike = cold brew launch, Aug 12', 'Not a one-off: Oct tracking +6%'],
  },
  {
    heading: 'Where it sold',
    body: 'Northside stores brought 38% of the growth, led by the flagship.',
    kind: 'bars',
    cue: 'Your stores: 38% of growth',
    notes: ["Thank Dana's team by name", 'Northside store is the model'],
  },
  {
    heading: 'What we propose for Q4',
    body: 'An end-cap in 40 stores from November 15 to December 31. We fund the displays.',
    kind: 'ask',
    cue: 'The ask: end-cap in 40 stores',
    notes: ['Nov 15 to Dec 31', 'We fund the displays', 'Pause. Let them answer.'],
  },
];
const months = [820, 860, 910, 990, 1080, 1180, 1300, 1460, 1620];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://usepagecue.com/" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#14171c" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://usepagecue.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="pagecue" />
    <meta property="og:image" content="https://usepagecue.com/og.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="pagecue: the page you share beside your private prompter" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <!-- Visit counts without cookies or personal data (see /guide/privacy/). -->
    <script is:inline data-goatcounter="https://pakothealpaco.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav wrap">
      <a class="brand" href="/" aria-label="pagecue home"><span class="mark" set:html={Mark} />pagecue</a>
      <nav aria-label="Main">
        <a href="/guide/">Guide</a>
        <a class="nav-github" href={repo} data-goatcounter-click="click-github-nav">GitHub</a>
        <a class="nav-cta" href="#install" data-goatcounter-click="click-install-nav">Install</a>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <section class="hero wrap">
        <h1>Speaker notes for any web page, written with Claude.</h1>
        <p class="lede">
          You made the report with Claude. Now you have to present it. Tell Claude what you want to say, and it shapes
          your words into a short cue for each part of the page. Your cues sit in a window you don't share, and follow
          the page as you scroll.
        </p>
        <div class="actions">
          <a class="button primary" href="#install" data-goatcounter-click="click-install-hero">Install for Chrome</a>
          <a class="button" href="/guide/quick-start/" data-goatcounter-click="click-try-hero">Try it in five minutes</a>
          <a class="button watch" href="https://youtu.be/gCTruNZXxYg" data-goatcounter-click="click-watch-video">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.6 8z" /></svg>Watch the video
          </a>
        </div>
      </section>

      <section class="stage-wrap wrap" aria-labelledby="stage-title">
        <h2 id="stage-title" class="visually-hidden">Try it here</h2>
        <p class="stage-hint" id="stage-hint">Scroll the report, or click a cue.</p>
        <div class="stage" data-stage>
          <div class="pane page-pane">
            <p class="pane-label"><span class="dot share"></span>What they see: the tab you share</p>
            <div class="window share-window">
              <div class="wchrome" aria-hidden="true">
                <span class="wlights"><i></i><i></i><i></i></span>
                <span class="waddress">northside-q3-review.app</span>
                <span class="wsharing">Sharing this tab</span>
              </div>
            <div class="page" tabindex="0" role="region" aria-label="Sample report, scrollable" aria-describedby="stage-hint" data-page>
              {
                parts.map((p, i) => (
                  <section class:list={['part', `part-${p.kind}`]} data-part={i}>
                    {i === 0 ? <h3 class="report-title">{p.heading}</h3> : <h3>{p.heading}</h3>}
                    {p.body && <p>{p.body}</p>}
                    {p.kind === 'stats' && (
                      <div class="stats">
                        <div><b>$4.2M</b><span>Revenue +31%</span></div>
                        <div><b>68%</b><span>Repeat buyers</span></div>
                        <div><b>41%</b><span>Gross margin</span></div>
                        <div><b>212</b><span>Stores</span></div>
                      </div>
                    )}
                    {p.kind === 'chart' && (
                      <div class="chart" aria-hidden="true">
                        {months.map((m, j) => (
                          <span style={`height: ${(m / 1700) * 100}%`} class:list={{ hot: j >= 6 }} />
                        ))}
                      </div>
                    )}
                    {p.kind === 'bars' && (
                      <div class="hbars" aria-hidden="true">
                        <span style="width: 92%">Northside</span>
                        <span style="width: 61%">Riverside</span>
                        <span style="width: 44%">Others</span>
                      </div>
                    )}
                  </section>
                ))
              }
              <p class="page-end">Halcyon Roasters is a made-up company. Try the full report with pagecue at <a href="/demo/">usepagecue.com/demo</a>.</p>
            </div>
            </div>
          </div>

          <div class="pane prompter-pane">
            <p class="pane-label"><span class="dot private"></span>What you see: the prompter</p>
            <div class="window prompter-window">
              <div class="wchrome" aria-hidden="true">
                <span class="wlights"><i></i><i></i><i></i></span>
                <span class="waddress">pagecue prompter</span>
              </div>
            <div class="prompter">
              <div class="p-top">
                <span class="light" aria-hidden="true"></span>
                <span class="p-title">Q3 partner review</span>
                <span class="p-pos" aria-live="polite"><span data-pos>1</span> of {parts.length}</span>
              </div>
              <div class="p-list" data-list>
                <ol data-track>
                  {
                    parts.map((p, i) => (
                      <li>
                        <button type="button" class="cue" data-cue={i}>
                          <strong>{p.cue}</strong>
                          <ul>
                            {p.notes.map((n) => (
                              <li>{n}</li>
                            ))}
                          </ul>
                        </button>
                      </li>
                    ))
                  }
                </ol>
              </div>
              <div class="p-bottom" aria-hidden="true">
                <span>0:42</span>
                <span class="p-tools"><span>Lines</span><span>A</span><span class="big">A</span><span>···</span></span>
              </div>
            </div>
            </div>
          </div>
        </div>
      </section>

      <section class="block wrap" aria-labelledby="claude-title">
        <div class="block-text">
          <h2 id="claude-title">You say what matters. Claude puts it in place.</h2>
          <p>
            Claude reads the page, so it knows the numbers and where each part starts. You bring what only you know:
            who's in the room, and what they should remember. It works in claude.ai, the Claude app and Claude Code.
          </p>
          <ol class="steps">
            <li><b>Ask in your own words.</b> "Add presenter cues to this report", in any language.</li>
            <li><b>Claude asks once what you want to say</b> at each part. Type it, dictate it, or say "you write it".</li>
            <li><b>Claude shapes each cue</b>: a headline of about eight words and up to three points, from your words and the page's facts only. When Claude builds the report, the cues come inside it.</li>
            <li><b>Rehearse, and ask for changes.</b> "Make cue 3 shorter." In Claude Code or the Claude app, each change shows in the prompter at once, with Undo.</li>
          </ol>
          <p><a href="/guide/claude/add-cues/">How Claude writes cues</a></p>
        </div>
        <div class="chat" aria-label="An example conversation with Claude">
          <p class="msg you">
            Add presenter cues to this report. On the revenue chart: September doubled March, because of the cold brew launch.
          </p>
          <p class="msg claude">
            I've planned six cues, one per part. What do you want to say on the numbers, the stores and the ask? Or I can
            write those from the page.
          </p>
          <p class="msg you">You write them. Thank Dana's team on the stores.</p>
          <p class="msg claude">Done: six cues for "Q3 partner review". Open the page and click pagecue.</p>
        </div>
      </section>

      <section class="block wrap" aria-labelledby="private-title">
        <div class="block-text">
          <h2 id="private-title">Viewers see the page, not your cues</h2>
          <p>
            The prompter is a window of its own. In Zoom, Meet or Teams, share the page's tab or window, and the prompter
            stays with you, like presenter view. pagecue draws nothing on the page you share, except section lines, and only
            while you have them on.
          </p>
          <p><a href="/guide/sharing/">Share your screen privately</a></p>
        </div>
        <div class="windows" aria-hidden="true">
          <figure class="win shared">
            <figcaption><span class="dot share"></span>Viewers see this tab</figcaption>
            <div class="chrome"><i></i><i></i><i></i><span>Q3 partner review</span></div>
            <div class="win-body">
              <b>Revenue by month</b>
              <div class="mini-chart">
                <span style="height: 40%"></span><span style="height: 46%"></span><span style="height: 52%"></span><span style="height: 60%"></span><span style="height: 70%"></span><span style="height: 82%"></span><span style="height: 100%"></span>
              </div>
            </div>
          </figure>
          <figure class="win mine">
            <figcaption><span class="dot private"></span>Only you see this</figcaption>
            <div class="win-body">
              <p class="dim">Four numbers, then stop talking</p>
              <p class="lit"><b>September doubled March</b>Spike = cold brew launch</p>
              <p class="dim">Your stores: 38% of growth</p>
            </div>
          </figure>
        </div>
      </section>

      <section class="wrap features" aria-labelledby="features-title">
        <h2 id="features-title">Made for talking, not reading</h2>
        <dl>
          <div>
            <dt>Cues you can read mid-sentence</dt>
            <dd>One cue lit at a time, level with your eye. The rest fades back.</dd>
          </div>
          <div>
            <dt>Scroll either side</dt>
            <dd>Scroll the page and the prompter follows. Click a cue, press <kbd>↓</kbd>, or use your clicker, and the page follows.</dd>
          </div>
          <div>
            <dt>Change any cue yourself</dt>
            <dd>Double-click a cue to change its words. Press <kbd>N</kbd> to add one. Your edits always win.</dd>
          </div>
          <div>
            <dt>Cues start where you want</dt>
            <dd>Press <kbd>L</kbd> to see where each cue starts, and drag to adjust. Then hide the lines.</dd>
          </div>
          <div>
            <dt>Works on the pages you present</dt>
            <dd>Reports, dashboards, docs, apps, Claude artifacts and local files. Any language.</dd>
          </div>
          <div>
            <dt>No account, no cloud</dt>
            <dd>Cues stay on your computer. Free and open source under MIT.</dd>
          </div>
        </dl>
      </section>

      <section class="wrap install" id="install" aria-labelledby="install-title">
        <h2 id="install-title">Install</h2>
        <div class="install-grid">
          <div>
            <h3>1. The Chrome extension</h3>
            <p>
              Coming soon to the Chrome Web Store. Until then, download it from GitHub and load it in Chrome: it takes a
              minute.
            </p>
            <a class="button primary" href={`${repo}/releases/latest`} data-goatcounter-click="click-download-extension">Download pagecue</a>
            <p class="small"><a href="/guide/install/" data-goatcounter-click="click-install-guide">Step-by-step install</a></p>
          </div>
          <div>
            <h3>2. The Claude plugin</h3>
            <p>
              In claude.ai or the Claude app: <b>Plugins → Add → Add marketplace</b>, then
              <code>pakothealpaco/pagecue</code>. In Claude Code:
            </p>
            <pre><code>/plugin marketplace add pakothealpaco/pagecue
/plugin install pagecue@pagecue</code></pre>
            <p class="small">
              Step by step: <a href="/guide/claude/apps/">claude.ai and the Claude app</a>.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot wrap">
      <nav aria-label="Footer">
        <a href="/guide/">Guide</a>
        <a href={repo} data-goatcounter-click="click-github-footer">GitHub</a>
        <a href="/guide/privacy/">Privacy</a>
        <a href={`${repo}/blob/main/CHANGELOG.md`}>Changelog</a>
        <a href={`${repo}/issues/new/choose`}>Report an issue</a>
      </nav>
      <nav aria-label="Use cases">
        <a href="/present-a-website-in-zoom/">Present a website in Zoom, Meet or Teams</a>
        <a href="/present-a-dashboard/">Present a dashboard</a>
        <a href="/teleprompter-for-screen-sharing/">A teleprompter for screen sharing</a>
        <a href="/ai-speaker-notes/">AI speaker notes with Claude</a>
      </nav>
      <p>Free and open source under the MIT licence. Made by Paco the Alpaca.</p>
    </footer>

    <script>
      // Count two moments that show interest, as cookieless GoatCounter events (see /guide/privacy/):
      // copying the Claude plugin commands, and the first touch of the demo.
      type Counter = { count?: (o: { path: string; title?: string; event: boolean }) => void };
      const countEvent = (path: string) => (window as unknown as { goatcounter?: Counter }).goatcounter?.count?.({ path, event: true });
      document.querySelector('.install pre')?.addEventListener('copy', () => countEvent('copy-plugin-command'));
      document
        .querySelector('[data-stage]')
        ?.addEventListener('pointerdown', () => countEvent('demo-touched'), { once: true, passive: true });

      // The stage: the report's parts and the prompter's cues, kept in step both ways, as in pagecue.
      const stage = document.querySelector<HTMLElement>('[data-stage]');
      if (stage) {
        const page = stage.querySelector<HTMLElement>('[data-page]')!;
        const list = stage.querySelector<HTMLElement>('[data-list]')!;
        const track = stage.querySelector<HTMLElement>('[data-track]')!;
        const parts = [...stage.querySelectorAll<HTMLElement>('[data-part]')];
        const cues = [...stage.querySelectorAll<HTMLButtonElement>('[data-cue]')];
        const pos = stage.querySelector<HTMLElement>('[data-pos]')!;
        const smooth = matchMedia('(prefers-reduced-motion: no-preference)').matches;
        const READING = 0.3;
        let current = -1;
        // While a click scrolls the report, its scroll events must not light the cues it passes.
        let steering = 0;

        const show = (i: number) => {
          if (i === current) return;
          current = i;
          cues.forEach((c, j) => c.classList.toggle('is-lit', j === i));
          pos.textContent = String(i + 1);
          const cue = cues[i].parentElement!;
          const y = cue.offsetTop - list.clientHeight * READING + 8;
          track.style.transform = `translateY(${-Math.max(0, y)}px)`;
        };

        const follow = () => {
          const line = page.scrollTop + page.clientHeight * READING;
          let i = 0;
          parts.forEach((p, j) => {
            if (p.offsetTop <= line + 1) i = j;
          });
          if (page.scrollTop + page.clientHeight >= page.scrollHeight - 2) i = parts.length - 1;
          show(i);
        };

        page.addEventListener(
          'scroll',
          () => {
            if (Date.now() > steering) follow();
          },
          { passive: true },
        );
        page.addEventListener('scrollend', () => {
          steering = 0;
          follow();
        });
        cues.forEach((c, i) =>
          c.addEventListener('click', () => {
            const top = parts[i].offsetTop - page.clientHeight * READING + 4;
            steering = Date.now() + 900;
            page.scrollTo({ top: Math.max(0, top), behavior: smooth ? 'smooth' : 'auto' });
            show(i);
          }),
        );
        addEventListener('resize', () => {
          const i = current;
          current = -1;
          show(Math.max(0, i));
        });
        follow();

        // Until the visitor touches the demo, it presents itself: the next cue every few seconds,
        // only while it is on screen, and never for people who ask for less motion.
        if (smooth) {
          let timer = 0;
          let touched = false;
          const next = () => cues[(current + 1) % cues.length].click();
          new IntersectionObserver(
            ([entry]) => {
              clearInterval(timer);
              if (!touched && entry.isIntersecting) timer = window.setInterval(next, 3000);
            },
            { threshold: 0.5 },
          ).observe(stage);
          for (const type of ['pointerdown', 'wheel', 'touchstart', 'keydown']) {
            stage.addEventListener(
              type,
              () => {
                touched = true;
                clearInterval(timer);
              },
              { passive: true },
            );
          }
        }
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f5f7f9;
    --raised: #ffffff;
    --ink: #151a22;
    --soft: #3d4550;
    --muted: #5e6672;
    --line: #dde2e9;
    --link: #137347;
    --live: #3ccf7f;
    --font: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    color-scheme: light;
  }
  /* The prompter in its light theme, as in the product (extension/src/prompter/styles.css). */
  .prompter,
  .win.mine {
    --bg: #ffffff;
    --line: #dde2e9;
    --ink: #151a22;
    --muted: #5e6672;
    --live: #1e9e63;
    /* Dimmer cues than the product's 0.4 would fail contrast on a web page. */
    --dim: 0.62;
    color: var(--ink);
  }
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--bg);
  }
  body {
    margin: 0;
    color: var(--ink);
    font: 400 1.0625rem/1.6 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: var(--link);
    text-underline-offset: 3px;
  }
  a:hover {
    color: #0b5132;
  }
  :focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 3px;
    border-radius: 4px;
  }
  kbd {
    font: 500 0.82em/1 var(--mono);
    padding: 0.16em 0.42em;
    border: 1px solid #cdd3db;
    border-bottom-width: 2px;
    border-radius: 5px;
    background: var(--raised);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: -3rem;
    padding: 0.5rem 0.8rem;
    background: var(--ink);
    color: #fff;
    border-radius: 6px;
    z-index: 10;
  }
  .skip:focus {
    top: 1rem;
  }
  .wrap {
    width: min(100% - 2.5rem, 1120px);
    margin-inline: auto;
  }
</style>

<style>
  /* Navigation */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .brand {
    line-height: 1;
  }
  .mark {
    display: flex;
  }
  .mark :global(svg) {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
  }
  .nav nav {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }
  .nav nav a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
  }
  .nav nav a:hover {
    color: var(--ink);
  }
  .nav nav .nav-cta {
    color: var(--ink);
    border: 1px solid #cdd3db;
    background: var(--raised);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
  }

  /* Hero */
  .hero {
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(2rem, 3.5vw, 2.75rem);
    text-align: center;
  }
  h1 {
    margin: 0 auto;
    max-width: 17ch;
    font-size: clamp(2.4rem, 5.6vw, 4.25rem);
    line-height: 1.02;
